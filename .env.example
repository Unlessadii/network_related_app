# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secrets & Security
JWT_SECRET=supersecret_netbypass_rural_security_key_2026_jwt_token
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DB_FILE=./backend/database/netbypass.sqlite

# Agricultural / Mandi API (Agmarknet / e-NAM)
# If empty, Net Bypass uses verified local pre-cached official APMC agricultural dataset
MANDI_API_URL=
MANDI_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
